{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "HMISConnection": "",
    "HOS_WEB_MVC_LIVE": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "HospitalMobileAPPApi",
    "Audience": "HospitalMobileApp",
    "ExpiryMinutes": 95
  },
  "Firebase": {
    "Enabled": true,
    "CredentialsPath": "firebase-service-account.json"
  },
  "Auth": {
    "OtpExpiryMinutes": 2,
    "PasswordResetWindowMinutes": 5,
    "DevAutoTrustContacts": [
    ]
  },
  "Sms": {
    "BaseUrl": "http://172.20.10.50:81/api/values/?_Send_to=",
    "TimeoutSeconds": 30,
    "ReturnDebugOtpOnFailure": true,
    "AndroidAppHash": "5/b9LMtqYqF"
  },
  "Security": {
    "MobileAppEmpId": 1,
    "RequireHttps": true
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "Messaging": {
    "UploadSubPath": "uploads/messages",
    "MaxAttachmentBytes": 10485760,
    "AllowedExtensions": ".pdf,.jpg,.jpeg,.png,.gif,.webp"
  },
  "MedicationReminders": {
    "EnableServerPush": true,
    "PollIntervalSeconds": 60
  },
  "AppointmentPrep": {
    "EnableServerPush": true,
    "PollIntervalSeconds": 60,
    "LookaheadDays": 21,
    "Radiology": {
      "HoursBefore": 12,
      "Title": "Radiology preparation reminder",
      "Instructions": "Please remain fasting (no food or drink except sips of water if allowed by your doctor) for at least 6–8 hours before your radiology appointment, unless your doctor advised otherwise. Bring prior films/CDs and your MR card. Arrive 15 minutes early.",
      "MatchKeywords": [ "RADIOLOGY", "RADIOLOG", "IMAGING", "X-RAY", "XRAY", "CT SCAN", "CT ", "MRI", "ULTRASOUND", "SONOGRAPHY", "FLUORO", "MAMMO", "NUCLEAR" ]
    },
    "Gastro": {
      "HoursBefore": 8,
      "Title": "Gastroenterology fasting reminder",
      "Instructions": "Please remain fasting (no solid food) for at least 8 hours before your gastroenterology / endoscopy appointment. Clear fluids may be allowed until 2–4 hours before the procedure — follow your doctor's written instructions. Do not take antacids unless advised. Bring a responsible adult if sedation is planned.",
      "MatchKeywords": [ "GASTRO", "GASTROENTEROLOGY", "ENDOSCOPY", "COLONOSCOPY", "EGD", "ERCP", "HEPATOBILIARY", "DIGESTIVE" ]
    }
  },
  "PaymentGateway": {
    "Provider": "Mock",
    "BaseCheckoutUrl": "https://pay.btkhospital.com/checkout",
    "WebhookSecret": "",
    "DefaultReturnUrl": "btihapp://payment/return",
    "PaymentExpiryMinutes": 30,
    "AllowMockConfirm": true,
    "EnablePaymentQr": true,
    "PublicApiBaseUrl": ""
  },
  "Admin": {
    "PasswordSalt": "BTIH_MOBILE_ADMIN",
    "BootstrapSecret": "",
    "TokenExpiryMinutes": 480
  },
  "Telemedicine": {
    "Provider": "Internal",
    "SessionExpiryMinutes": 60,
    "PatientJoinBaseUrl": "btihapp://telemed/join"
  },
  "Support": {
    "HospitalName": "Bahria Town International Hospital",
    "Phone": "051-111-111-111",
    "Email": "it@btkhospital.com",
    "Address": "Bahria Town, Rawalpindi",
    "WorkingHours": "24/7 Emergency | OPD 8:00 AM – 8:00 PM"
  },
  "Monitoring": {
    "EnableSerilogFile": true,
    "LogFilePath": "logs/bti-hospital-api-.log",
    "EnableHealthEndpoint": true
  },
  "AllowedHosts": "*",
  "EnableSwagger": false
}
