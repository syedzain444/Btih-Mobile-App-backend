{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "HMISConnection": "",
    "HOS_WEB_MVC_LIVE": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "HospitalMobileAPPApi",
    "Audience": "HospitalMobileApp",
    "ExpiryMinutes": 95
  },
  "Firebase": {
    "Enabled": true,
    "CredentialsPath": "firebase-service-account.json"
  },
  "Auth": {
    "OtpExpiryMinutes": 2,
    "PasswordResetWindowMinutes": 5
  },
  "Sms": {
    "BaseUrl": "http://172.20.10.50:81/api/values/?_Send_to=",
    "TimeoutSeconds": 30
  },
  "Security": {
    "MobileAppEmpId": 1,
    "RequireHttps": true
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "AllowedHosts": "*",
  "EnableSwagger": false
}
