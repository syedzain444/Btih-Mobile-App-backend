{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "HMISConnection": "",
    "HOS_WEB_MVC_LIVE": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "HospitalMobileAPPApi",
    "Audience": "HospitalMobileApp",
    "ExpiryMinutes": 95
  },
  "Firebase": {
    "Enabled": true,
    "CredentialsPath": "firebase-service-account.json"
  },
  "Auth": {
    "OtpExpiryMinutes": 2,
    "PasswordResetWindowMinutes": 5,
    "DevAutoTrustContacts": [
    ]
  },
  "Sms": {
    "BaseUrl": "http://172.20.10.50:81/api/values/?_Send_to=",
    "TimeoutSeconds": 30,
    "ReturnDebugOtpOnFailure": true
  },
  "Security": {
    "MobileAppEmpId": 1,
    "RequireHttps": true
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "Messaging": {
    "UploadSubPath": "uploads/messages",
    "MaxAttachmentBytes": 10485760,
    "AllowedExtensions": ".pdf,.jpg,.jpeg,.png,.gif,.webp"
  },
  "MedicationReminders": {
    "EnableServerPush": true,
    "PollIntervalSeconds": 60
  },
  "PaymentGateway": {
    "Provider": "Mock",
    "BaseCheckoutUrl": "https://pay.btkhospital.com/checkout",
    "WebhookSecret": "",
    "DefaultReturnUrl": "btihapp://payment/return",
    "PaymentExpiryMinutes": 30,
    "AllowMockConfirm": true
  },
  "Admin": {
    "PasswordSalt": "BTIH_MOBILE_ADMIN",
    "BootstrapSecret": "",
    "TokenExpiryMinutes": 480
  },
  "Telemedicine": {
    "Provider": "Internal",
    "SessionExpiryMinutes": 60,
    "PatientJoinBaseUrl": "btihapp://telemed/join"
  },
  "Support": {
    "HospitalName": "Bahria Town International Hospital",
    "Phone": "051-111-111-111",
    "Email": "it@btkhospital.com",
    "Address": "Bahria Town, Rawalpindi",
    "WorkingHours": "24/7 Emergency | OPD 8:00 AM – 8:00 PM"
  },
  "Monitoring": {
    "EnableSerilogFile": true,
    "LogFilePath": "logs/bti-hospital-api-.log",
    "EnableHealthEndpoint": true
  },
  "AllowedHosts": "*",
  "EnableSwagger": false
}
